# Line endings are not cosmetic here. Every executable file in this repository
# is a shell script, and a script checked out with CRLF fails on its own shebang
# -- bash looks for an interpreter named "bash\r" and reports that it does not
# exist. On Windows, git's default core.autocrlf=true would do exactly that to a
# fresh clone, so the working tree is pinned to LF regardless of platform.
* text=auto eol=lf

*.sh    text eol=lf
*.conf  text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.txt   text eol=lf
LICENSE text eol=lf
